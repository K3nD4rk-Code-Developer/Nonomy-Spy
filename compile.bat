@echo off
setlocal

REM Delete "out" folder if it exists
if exist "out" (
    echo Deleting folder: out
    rmdir /s /q "out"
)

REM Delete files inside the "ci" folder if they exist
if exist "ci\NonomySpy.rbxm" (
    echo Deleting ci\NonomySpy.rbxm
    del /f /q "ci\NonomySpy.rbxm"
)

if exist "ci\NonomySpy.dev.lua" (
    echo Deleting ci\NonomySpy.dev.lua
    del /f /q "ci\NonomySpy.dev.lua"
)

REM Run npm command
echo Running npm run return ...
npm run return

REM Open NonomySpy.dev.lua (new one generated by npm command)
if exist "ci\NonomySpy.dev.lua" (
    echo Opening NonomySpy.dev.lua...
    start "" "ci\NonomySpy.dev.lua"
)

endlocal
pause
